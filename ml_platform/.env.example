# ML Platform backend configuration template.
# Copy to .env and fill in real values. Placeholders only — no usable
# credentials live in this file (blueprint A0).

# development | test | production
# production enables strict startup validation: the app REFUSES to boot with
# any of the dev defaults below still in effect.
ENVIRONMENT=development

# Required in production. Async SQLAlchemy URL, e.g.
#   mysql+aiomysql://USER:PASSWORD@HOST:3306/ml_platform
# Dev default (when unset): sqlite+aiosqlite:///./storage/ml_platform.db
DATABASE_URL=

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# inprocess (single-process dev) | celery (production worker pool)
SCHEDULER_MODE=inprocess
# memory | redis (required when SCHEDULER_MODE=celery)
EVENT_BUS_MODE=memory

STORAGE_UPLOADS=./storage/uploads
STORAGE_MODELS=./storage/models
STORAGE_LOGS=./storage/logs
MLFLOW_TRACKING_URI=sqlite:///./storage/mlflow.db
MAX_UPLOAD_SIZE=209715200

# Object storage (MinIO / S3-compatible). With S3_ENABLED=true in production,
# access/secret keys must NOT be the dev defaults.
S3_ENABLED=false
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ml-platform

# User-code executors (workflow 代码配置 / 数据 Pipeline) — sandbox timeouts.
USER_CODE_TIMEOUT_S=5
PIPELINE_CODE_TIMEOUT_S=60
