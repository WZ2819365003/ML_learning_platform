      "n_estimators": [200, 400],
      "learning_rate": [0.03, 0.1],
      "max_depth": [4, 6, 8]
    },
    "lightgbm_regressor": {
      "n_estimators": [200, 400],
      "learning_rate": [0.03, 0.1],
      "num_leaves": [31, 63]
    },
    "random_forest_regressor": {
      "n_estimators": [100, 200, 400],
      "max_depth": [null, 6, 12]
    }
  },
  "budget_config": {
    "max_trials": 12,
    "cv_folds": 5,
    "test_size": 0.2
