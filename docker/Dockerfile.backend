# ML Platform Backend - FastAPI
FROM python:3.11-slim

WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 复制 requirements.txt
COPY ml_platform/requirements.txt /app/requirements.txt

# 安装 Python 依赖
RUN pip install --no-cache-dir -r requirements.txt || pip install --no-cache-dir \
    fastapi==0.115.6 \
    uvicorn[standard]==0.34.0 \
    sqlalchemy==2.0.36 \
    alembic==1.14.1 \
    aiosqlite==0.20.0 \
    aiomysql==0.2.0 \
    python-dotenv==1.0.1 \
    pydantic==2.9.2 \
    scikit-learn==1.5.2 \
    xgboost==2.1.3 \
    lightgbm==4.3.0 \
    shap==0.45.1 \
    numpy==2.0.2 \
    pandas==2.2.3 \
    matplotlib==3.9.2 \
    seaborn==0.13.2 \
    joblib==1.4.2 \
    python-multipart==0.0.7 \
    boto3==1.34.128 \
    requests==2.32.3

# 复制后端代码
COPY ml_platform /app

WORKDIR /app

# 暴露端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health')" || exit 1

# 启动 FastAPI
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
