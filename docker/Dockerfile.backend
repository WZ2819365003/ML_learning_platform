# ML Platform Backend - FastAPI
FROM python:3.11-slim

WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    aria2 \
    gcc \
    g++ \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 复制 requirements.txt
COPY ml_platform/requirements.txt /app/requirements.txt

# requirements.txt is the single dependency source. It pins the production
# PyTorch CPU wheel directly; the primary mirror avoids slow, incomplete PyPI
# index responses. Fail the build instead of installing a stale fallback set.
ARG PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN set -eux; \
    torch_ref="$(awk '/^torch @ https:\/\/.*linux_x86_64/ {print $3; exit}' requirements.txt)"; \
    torch_url="${torch_ref%%#sha256=*}"; \
    torch_sha="${torch_ref##*#sha256=}"; \
    aria2c --allow-overwrite=true --auto-file-renaming=false \
      --console-log-level=warn --file-allocation=none \
      --max-connection-per-server=16 --split=16 --min-split-size=1M \
      --dir=/tmp --out=torch.whl "$torch_url"; \
    echo "$torch_sha  /tmp/torch.whl" | sha256sum -c -; \
    sed "s|$torch_ref|file:///tmp/torch.whl#sha256=$torch_sha|" \
      requirements.txt > /tmp/requirements-docker.txt; \
    pip install --no-cache-dir --retries 10 --timeout 120 \
      --index-url "$PYPI_INDEX_URL" \
      -r /tmp/requirements-docker.txt; \
    rm -f /tmp/torch.whl /tmp/requirements-docker.txt

# 复制后端代码
COPY ml_platform /app

WORKDIR /app

# 暴露端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health')" || exit 1

# 启动 FastAPI
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
