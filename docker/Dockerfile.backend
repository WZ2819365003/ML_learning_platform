# ML Platform Backend - FastAPI
FROM python:3.11-slim

WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 复制 requirements.txt
COPY ml_platform/requirements.txt /app/requirements.txt

# requirements.txt is the single dependency source. Its extra index resolves
# PyTorch CPU wheels; the primary mirror avoids slow, incomplete PyPI index
# responses on the production host. Fail the image build instead of silently
# installing a stale fallback dependency set.
ARG PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN pip install --no-cache-dir --retries 10 --timeout 120 \
    --index-url "$PYPI_INDEX_URL" \
    -r requirements.txt

# 复制后端代码
COPY ml_platform /app

WORKDIR /app

# 暴露端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health')" || exit 1

# 启动 FastAPI
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
