# ML Platform Frontend - React + Vite
# 构建阶段
FROM node:20-alpine AS builder

WORKDIR /app

# 复制 package.json
COPY ml_platform_web/package*.json /app/

# 安装依赖
# npm install (not ci): tolerate npm 10/11 lockfile semantic drift between
# local dev and the node:20-alpine builder — ci hard-fails on any mismatch.
RUN npm install --prefer-offline --no-audit

# 复制源代码
COPY ml_platform_web /app

# 构建
RUN npm run build

# 运行阶段
FROM node:20-alpine

WORKDIR /app

# 安装轻量级 HTTP 服务器
RUN npm install -g serve

# 复制构建输出
COPY --from=builder /app/dist /app/dist

# 暴露端口
EXPOSE 3000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:3000 || exit 1

# 启动服务
CMD ["serve", "-s", "dist", "-l", "3000"]
